rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
      allow write: if false; // Only manageable from backend/console if needed

      // Operators
      function isValidOperator(data) {
        return data.keys().hasAll(['name', 'machineType', 'departmentId', 'status', 'lastMovedAt'])
            && data.name is string && data.name.size() <= 100
            && data.machineType in ['LL', 'RTR', 'NONE']
            && data.departmentId is string && data.departmentId.size() <= 50
            && data.status in ['active', 'break', 'absence']
            && data.lastMovedAt is string && data.lastMovedAt.size() <= 50
            && (!data.keys().hasAny(['revision']) || (data.revision is number && data.revision >= 0))
            && (!data.keys().hasAny(['isVnaOnly']) || data.isVnaOnly is bool)
            && (!data.keys().hasAny(['shift']) || data.shift in ['A', 'B', 'C'])
            && (!data.keys().hasAny(['absenceReason']) || data.absenceReason in ['Absence', 'Dovolená', 'PN'])
            && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 500));
      }

      match /operators/{operatorId} {
        allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
        allow create: if isSignedIn() 
            && workspaceId == 'zf_ostrov'
            && isValidId(operatorId)
            && isValidOperator(incoming());
        allow update: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(operatorId)
            && isValidOperator(incoming());
        allow delete: if isSignedIn() && workspaceId == 'zf_ostrov' && isValidId(operatorId);
      }

      // History
      function isValidHistoryRecord(data) {
        return data.keys().hasAll(['operatorId', 'operatorName', 'machineType', 'fromDept', 'toDept', 'timestamp'])
            && data.operatorId is string && data.operatorId.size() <= 128
            && data.operatorName is string && data.operatorName.size() <= 100
            && data.machineType in ['LL', 'RTR', 'NONE']
            && data.fromDept is string && data.fromDept.size() <= 50
            && data.toDept is string && data.toDept.size() <= 50
            && data.timestamp is string && data.timestamp.size() <= 50
            && (!data.keys().hasAny(['shift']) || data.shift in ['A', 'B', 'C'])
            && (!data.keys().hasAny(['reason']) || (data.reason is string && data.reason.size() <= 500));
      }

      match /history/{historyId} {
        allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
        allow create: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(historyId)
            && isValidHistoryRecord(incoming());
        allow update: if false; // History is immutable
        allow delete: if isSignedIn() && workspaceId == 'zf_ostrov' && isValidId(historyId);
      }

      // Templates
      function isValidTemplate(data) {
        return data.keys().hasAll(['name', 'operatorCount', 'activeCount', 'createdAt'])
            && data.name is string && data.name.size() <= 120
            && data.operatorCount is number
            && data.activeCount is number
            && data.createdAt is string && data.createdAt.size() <= 50
            && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500))
            && (!data.keys().hasAny(['isBuiltIn']) || data.isBuiltIn is bool)
            && (!data.keys().hasAny(['shift']) || data.shift in ['A', 'B', 'C', 'all'])
            && (!data.keys().hasAny(['assignments']) || data.assignments is list);
      }

      match /templates/{templateId} {
        allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
        allow create: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(templateId)
            && isValidTemplate(incoming());
        allow update: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(templateId)
            && isValidTemplate(incoming());
        allow delete: if isSignedIn() && workspaceId == 'zf_ostrov' && isValidId(templateId);
      }

      // Custom Departments
      function isValidCustomDept(data) {
        return data.keys().hasAll(['name', 'fullName', 'code', 'createdAt'])
            && data.name is string && data.name.size() <= 100
            && data.fullName is string && data.fullName.size() <= 120
            && data.code is string && data.code.size() <= 20
            && data.createdAt is string && data.createdAt.size() <= 50
            && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500))
            && (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() <= 50))
            && (!data.keys().hasAny(['badgeBg']) || (data.badgeBg is string && data.badgeBg.size() <= 200))
            && (!data.keys().hasAny(['badgeText']) || (data.badgeText is string && data.badgeText.size() <= 200))
            && (!data.keys().hasAny(['borderColor']) || (data.borderColor is string && data.borderColor.size() <= 200))
            && (!data.keys().hasAny(['iconName']) || (data.iconName is string && data.iconName.size() <= 50))
            && (!data.keys().hasAny(['targetCount']) || data.targetCount is number)
            && (!data.keys().hasAny(['shift']) || data.shift in ['A', 'B', 'C']);
      }

      match /custom_departments/{deptId} {
        allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
        allow create: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(deptId)
            && isValidCustomDept(incoming());
        allow update: if isSignedIn()
            && workspaceId == 'zf_ostrov'
            && isValidId(deptId)
            && isValidCustomDept(incoming());
        allow delete: if isSignedIn() && workspaceId == 'zf_ostrov' && isValidId(deptId);
      }

      // Settings (e.g. ocr_config, custom instructions)
      match /settings/{settingId} {
        allow read: if isSignedIn() && workspaceId == 'zf_ostrov';
        allow create, update, delete: if isSignedIn() && workspaceId == 'zf_ostrov' && isValidId(settingId);
      }
    }
  }
}
